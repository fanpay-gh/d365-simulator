# Identidad que el mock acepta en el token endpoint
MOCK_TENANT_ID=11111111-1111-1111-1111-111111111111
MOCK_CLIENT_ID=22222222-2222-2222-2222-222222222222
MOCK_CLIENT_SECRET=mock-client-secret

# URL pública del mock (sin slash final). Se usa como `aud` del token, como
# scope (<MOCK_BASE_URL>/.default) y en OData-EntityId / @odata.context.
# Si se omite: http://localhost:$PORT
# MOCK_BASE_URL=http://localhost:8000   # en Netlify, déjala sin definir para usar el origen de cada petición

TOKEN_TTL_SECONDS=3600
PORT=8000

# Opcionales
# MOCK_SIGNING_KEY=clave-para-firmar-jwt-HS256
# MOCK_PERSIST_FILE=data/records.json   # volcado de registros a JSON
# MOCK_SCHEMA_FILE=schema.yaml
# MOCK_REQUEST_LOG_MAX=200
